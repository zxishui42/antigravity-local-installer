{
  "schema_version": 1,
  "rules": [
    {
      "id": "windows-cpu-16plus-12b",
      "priority": 300,
      "match": {
        "os": [
          "windows"
        ],
        "graphics": [
          "cpu-only"
        ],
        "runtime": [
          "automatic",
          "ollama"
        ],
        "min_memory_gb": 16
      },
      "profile_id": "windows-ollama-gemma4-12b-qat",
      "status": "installer_available",
      "final_check": "installer"
    },
    {
      "id": "windows-explicit-ollama-e2b",
      "priority": 100,
      "match": {
        "os": [
          "windows"
        ],
        "graphics": [
          "nvidia",
          "amd",
          "cpu-only"
        ],
        "runtime": [
          "ollama"
        ]
      },
      "profile_id": "windows-ollama-gemma4-e2b",
      "status": "installer_available",
      "final_check": "installer"
    },
    {
      "id": "windows-auto-gpu-under24-e2b",
      "priority": 110,
      "match": {
        "os": [
          "windows"
        ],
        "graphics": [
          "nvidia",
          "amd"
        ],
        "runtime": [
          "automatic"
        ],
        "max_vram_gb": 23
      },
      "profile_id": "windows-ollama-gemma4-e2b",
      "status": "installer_available",
      "final_check": "installer"
    },
    {
      "id": "windows-auto-cpu-e2b",
      "priority": 110,
      "match": {
        "os": [
          "windows"
        ],
        "graphics": [
          "cpu-only"
        ],
        "runtime": [
          "automatic"
        ],
        "min_memory_gb": 8
      },
      "profile_id": "windows-ollama-gemma4-e2b",
      "status": "installer_available",
      "final_check": "installer"
    }
  ],
  "default_status": "no_verified_installer",
  "notes": [
    "Automatic GPU configurations at 24 GB VRAM or above are intentionally not mapped to the Ollama E2B package because the live site currently points that tier toward LiteRT.",
    "A configuration is only marked installer_available when its target profile is verified.",
    "The 12B CPU profile is only routed to 16 GB+ CPU-only configurations because that exact class passed a real Windows 16 GB no-GPU integration run."
  ]
}
