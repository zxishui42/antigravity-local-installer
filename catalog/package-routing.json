{
  "schema_version": 1,
  "rules": [
    {
      "id": "windows-nvidia-24plus-litert-pending",
      "priority": 500,
      "match": {
        "os": [
          "windows"
        ],
        "graphics": [
          "nvidia"
        ],
        "runtime": [
          "automatic",
          "litert"
        ],
        "min_vram_gb": 24
      },
      "profile_id": "windows-litert-gemma4-26b",
      "status": "pending_validation",
      "final_check": "physical_nvidia_24gb"
    },
    {
      "id": "windows-cpu-32plus-12b",
      "priority": 300,
      "match": {
        "os": [
          "windows"
        ],
        "graphics": [
          "cpu-only"
        ],
        "runtime": [
          "automatic",
          "ollama"
        ],
        "min_memory_gb": 32
      },
      "profile_id": "windows-ollama-gemma4-12b-qat",
      "status": "installer_available",
      "final_check": "installer"
    },
    {
      "id": "windows-cpu-16to31-e4b",
      "priority": 250,
      "match": {
        "os": [
          "windows"
        ],
        "graphics": [
          "cpu-only"
        ],
        "runtime": [
          "automatic",
          "ollama"
        ],
        "min_memory_gb": 16,
        "max_memory_gb": 31
      },
      "profile_id": "windows-ollama-gemma4-e4b-qat",
      "status": "installer_available",
      "final_check": "installer"
    },
    {
      "id": "windows-explicit-ollama-gpu-e2b",
      "priority": 100,
      "match": {
        "os": [
          "windows"
        ],
        "graphics": [
          "nvidia",
          "amd"
        ],
        "runtime": [
          "ollama"
        ]
      },
      "profile_id": "windows-ollama-gemma4-e2b",
      "status": "installer_available",
      "final_check": "installer"
    },
    {
      "id": "windows-auto-nvidia-under24-e2b",
      "priority": 110,
      "match": {
        "os": [
          "windows"
        ],
        "graphics": [
          "nvidia"
        ],
        "runtime": [
          "automatic"
        ],
        "max_vram_gb": 23
      },
      "profile_id": "windows-ollama-gemma4-e2b",
      "status": "installer_available",
      "final_check": "installer"
    },
    {
      "id": "windows-auto-amd-e2b",
      "priority": 110,
      "match": {
        "os": [
          "windows"
        ],
        "graphics": [
          "amd"
        ],
        "runtime": [
          "automatic"
        ]
      },
      "profile_id": "windows-ollama-gemma4-e2b",
      "status": "installer_available",
      "final_check": "installer"
    }
  ],
  "default_status": "no_verified_installer",
  "notes": [
    "Windows CPU-only 8 GB stays no_verified_installer because no paid package has been validated for that RAM class.",
    "Windows CPU-only 16 GB routes to the smaller E4B QAT profile; 32 GB and above routes to the validated 12B QAT profile.",
    "Automatic GPU configurations at 24 GB VRAM or above are intentionally not mapped to Ollama because the live site points that tier toward LiteRT.",
    "Explicit Ollama GPU configurations below or above 24 GB use the verified E2B package for now; the installer rechecks actual Windows RAM before making changes.",
    "A configuration is only marked installer_available when its target profile is verified.",
    "Windows NVIDIA 24 GB+ LiteRT combinations are tracked as pending_validation until the full package passes on a physical supported NVIDIA machine; they are not released or sold as an installer yet.",
    "Live-site checks confirmed Windows AMD 24/32/48 GB Automatic stays on Ollama, so AMD Automatic does not switch to LiteRT at 24 GB."
  ]
}
