    {
      "id": "windows-cpu-8gb-ollama-pending",
      "priority": 240,
      "match": {
        "os": [
          "windows"
        ],
        "graphics": [
          "cpu-only"
        ],
        "runtime": [
          "automatic",
          "ollama"
        ],
        "min_memory_gb": 8,
        "max_memory_gb": 8
