{
  "schema_version": 1,
  "rules": [
    {
      "id": "windows-nvidia-24plus-litert-pending",
      "priority": 500,
      "match": {
        "os": [
          "windows"
        ],
        "graphics": [
          "nvidia"
        ],
        "runtime": [
          "automatic",
          "litert"
        ],
        "min_vram_gb": 24
      },
      "profile_id": "windows-litert-gemma4-26b",
      "status": "pending_validation",
      "final_check": "physical_nvidia_24gb"
    },
    {
      "id": "windows-cpu-32plus-12b",
      "priority": 300,
      "match": {
        "os": [
          "windows"
        ],
        "graphics": [
          "cpu-only"
        ],
        "runtime": [
          "automatic",
          "ollama"
        ],
        "min_memory_gb": 32
      },
      "profile_id": "windows-ollama-gemma4-12b-qat",
      "status": "installer_available",
      "final_check": "installer"
    },
    {
      "id": "windows-cpu-16to31-e4b",
